{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chappe",
  "version": "0.4.0",
  "identifier": "dev.chappe.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Chappe",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 420,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 20
        },
        "backgroundColor": "#191E29",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Terminal and SSH client"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDREMTVBMkEyNjRDMjY1M0MKUldROFpjSmtvcUlWVFh0ekU2TENzeFBDb2FwTVNab2xCYkNwWUtGeTFEUXNBKzFFNWFRL0VNTmcK",
      "endpoints": [
        "https://github.com/Modship/chappe/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
